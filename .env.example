# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — NEVER commit real secrets.

# RentCast API key (https://app.rentcast.io/app/api). Only needed if the
# "rentcast" source is enabled in config.local.json.
RENTCAST_API_KEY=your_rentcast_key_here

# Gmail address you send the digest FROM.
GMAIL_SENDER=you@gmail.com

# Where to send the digest. Optional — defaults to GMAIL_SENDER (send to yourself).
# Kept here (not in config) so it stays out of a public repo.
DIGEST_RECIPIENT=you@gmail.com

# Google App Password for that account (https://myaccount.google.com/apppasswords).
# Requires 2-Step Verification. 16 characters; spaces are fine.
GMAIL_APP_PASSWORD=your_app_password_here
